[Unit]
Description=Benzin community leaderboard
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=benzin
WorkingDirectory=/opt/benzin
ExecStart=/usr/bin/python3 /opt/benzin/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
